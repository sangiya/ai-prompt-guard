# Copy to .env and set whichever provider you intend to use.
# With none configured the toolkit uses its deterministic offline backend,
# so every command and the full test suite still run.

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Override the default model for the selected provider.
# LLM_MODEL=claude-sonnet-4-6

# Local Ollama endpoint, used when no API key is present.
# OLLAMA_HOST=http://localhost:11434
